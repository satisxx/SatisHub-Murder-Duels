    local b = makeButton(row, 'OFF', width - 77, 7, 64, 30, function(btn)
        cfg[key] = not cfg[key]
        saveSettings()
        if key == 'noclip' and not cfg[key] then restoreCollision() end
        btn.Text = cfg[key] and 'ON' or 'OFF'
        btn.TextColor3 = cfg[key] and GOLD or MUTED
        btn.BackgroundColor3 = cfg[key] and Color3.fromRGB(83, 52, 9) or PANEL2
        btn:SetAttribute('RestColor', btn.BackgroundColor3)
        if statusText then
            statusText.Text = cfg[key] and ('●  ' .. string.upper(caption) .. ' ENABLED') or ('●  ' .. string.upper(caption) .. ' DISABLED')
            statusText.TextColor3 = cfg[key] and GREEN or RED
        end
    end)
    b.Text = cfg[key] and 'ON' or 'OFF'
    b.TextColor3 = cfg[key] and GOLD or MUTED
    b.BackgroundColor3 = cfg[key] and Color3.fromRGB(83, 52, 9) or PANEL2
    b:SetAttribute('RestColor', b.BackgroundColor3)
    return row
end

local function makeSlider(parent, caption, key, x, y, width, minimum, maximum, decimals)
    local holder = frame(parent, x, y, width, 78, PANEL, 7, 0.28)
    rounded(holder, 10)
    stroke(holder, Color3.fromRGB(92, 72, 44), 1, 0.40)
    label(holder, caption, 12, 8, width - 102, 23, 12, WHITE, Enum.Font.GothamBold, 9)
    local value = label(holder, '', width - 110, 8, 99, 23, 13, GOLD, Enum.Font.GothamBold, 9)
    value.TextXAlignment = Enum.TextXAlignment.Right
    local track = frame(holder, 14, 47, width - 28, 6, Color3.fromRGB(63, 63, 66), 9, 0.20)
    rounded(track, 3)
    local fill = frame(track, 0, 0, 0, 6, GOLD, 10, 0)
    rounded(fill, 3)
    local knobGlow = glow(track, -2, -7, 20, 20, GOLD, 0.86, 10)
    knobGlow.BackgroundTransparency = 0.86
    local knob = frame(track, 0, -5, 16, 16, WHITE, 11, 0)
    rounded(knob, 9)
    local sliding = false
    local function refresh()
        local alpha = math.clamp((cfg[key] - minimum) / (maximum - minimum), 0, 1)
        fill.Size = UDim2.new(alpha, 0, 0, 6)
        knob.Position = UDim2.new(alpha, -8, 0, -5)
        knobGlow.Position = UDim2.new(alpha, -10, 0, -7)
        if decimals == 0 then value.Text = string.format('%d', math.floor(cfg[key] + 0.5)) else value.Text = string.format('%.2f', cfg[key]) end
    end
    local function setAt(mouseX)
        local alpha = math.clamp((mouseX - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
        local amount = minimum + (maximum - minimum) * alpha
        cfg[key] = (decimals == 0) and math.floor(amount + 0.5) or math.floor(amount * 100 + 0.5) / 100
        refresh()
        saveSettings()
    end
    bind(holder.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = true; setAt(input.Position.X) end
    end)
    bind(UIS.InputChanged, function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then setAt(input.Position.X) end
    end)
    bind(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = false end
    end)
    refresh()
    return holder
end

local function makeChoice(parent, caption, options, key, x, y, width)
    local holder = frame(parent, x, y, width, 44, PANEL, 7, 0.28)
    rounded(holder, 10)
    stroke(holder, Color3.fromRGB(92, 72, 44), 1, 0.45)
    label(holder, caption, 12, 4, 145, 35, 12, WHITE, Enum.Font.GothamBold, 8)
    local btn = makeButton(holder, '', width - 131, 6, 118, 32, function(b)
        local current = cfg[key]
        local index = table.find(options, current) or 0
        cfg[key] = options[(index % #options) + 1]
        b.Text = cfg[key] == 'HumanoidRootPart' and 'Torso' or cfg[key]
        saveSettings()
        if statusText then
            statusText.Text = '●  ' .. caption .. ': ' .. b.Text
            statusText.TextColor3 = GOLD
        end
    end)
    btn.Text = cfg[key] == 'HumanoidRootPart' and 'Torso' or cfg[key]
    btn.TextColor3 = GOLD
    btn:SetAttribute('RestColor', btn.BackgroundColor3)
    return holder
end


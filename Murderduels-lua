local promoActive = true
local function dismissPromo()
    if not promoActive then return end
    promoActive = false
    tween(DiscordGui, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Position = UDim2.new(0.5, 0, 0, -170),
        BackgroundTransparency = 1,
    })
    task.delay(0.30, function()
        if DiscordGui and DiscordGui.Parent then DiscordGui:Destroy() end
    end)
end

tween(DiscordGui, TweenInfo.new(0.48, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Position = UDim2.new(0.5, 0, 0, 24),
})
task.spawn(function()
    for seconds = 10, 1, -1 do
        if not alive or not promoActive then return end
        promoCountdown.Text = 'Closing in ' .. seconds .. ' seconds'
        task.wait(1)
    end
    if alive then dismissPromo() end
end)


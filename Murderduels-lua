local function toggle(page,text,key)
    local row=box(page,UDim2.new(),UDim2.new(1,-5,0,46),panel);addCorner(row,8)
    label(row,text,UDim2.fromOffset(13,0),UDim2.new(1,-100,1,0),Enum.Font.GothamBold,white,12)
    local b=Instance.new('TextButton');b.Size=UDim2.fromOffset(64,27);b.Position=UDim2.new(1,-76,.5,-13);b.BorderSizePixel=0;b.Font=Enum.Font.GothamBold;b.TextSize=11;b.Parent=row;addCorner(b,7)
    local function refresh() b.Text=cfg[key] and 'ON' or 'OFF';b.TextColor3=cfg[key] and green or red;b.BackgroundColor3=elevated end
    connect(b.MouseButton1Click,function()cfg[key]=not cfg[key];refresh();if key=='noclip' and not cfg[key] then for part,old in pairs(collisions) do if part.Parent then part.CanCollide=old end end;table.clear(collisions) end end)
    refresh()
end
local function stepper(page,text,key,min,max,step,format)
    local row=box(page,UDim2.new(),UDim2.new(1,-5,0,50),panel);addCorner(row,8)
    label(row,text,UDim2.fromOffset(13,5),UDim2.fromOffset(200,18),Enum.Font.GothamBold,white,12)
    local display=label(row,'',UDim2.fromOffset(13,24),UDim2.fromOffset(110,19),Enum.Font.Gotham,gold,12)
    local function change(delta) cfg[key]=math.clamp(math.floor((cfg[key]+delta)*1000+.5)/1000,min,max);display.Text=string.format(format,cfg[key]) end
    for i,option in ipairs({{'−',-step},{'+',step}}) do
        local b=Instance.new('TextButton');b.Size=UDim2.fromOffset(36,30);b.Position=UDim2.new(1,-86+(i-1)*43,.5,-15);b.BackgroundColor3=elevated;b.BorderSizePixel=0;b.Text=option[1];b.TextColor3=gold;b.TextSize=18;b.Font=Enum.Font.GothamBold;b.Parent=row;addCorner(b,6);connect(b.MouseButton1Click,function()change(option[2]) end)
    end
    change(0)
end
local function action(page,text,callback)
    local b=Instance.new('TextButton');b.Size=UDim2.new(1,-5,0,42);b.BackgroundColor3=panel;b.BorderSizePixel=0;b.Text=text;b.TextColor3=white;b.Font=Enum.Font.GothamBold;b.TextSize=12;b.Parent=page;addCorner(b,8);connect(b.MouseButton1Click,function()callback(b)end);return b
end


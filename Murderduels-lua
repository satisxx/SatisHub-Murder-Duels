local function clearESP()
    for p, obj in pairs(highlights) do
        pcall(function() obj:Destroy() end)
        highlights[p] = nil
    end
end

local function refreshESP()
    if not cfg.esp then
        clearESP()
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local ch = p.Character
            if highlights[p] and (not ch or highlights[p].Adornee ~= ch) then
                highlights[p]:Destroy()
                highlights[p] = nil
            end
            if ch and not highlights[p] then
                local h = Instance.new('Highlight')
                h.Name = 'SatisHub_Meliodas_ESP'
                h.Adornee = ch
                h.FillColor = GOLD
                h.FillTransparency = 0.72
                h.OutlineColor = WHITE
                h.OutlineTransparency = 0
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = gui
                highlights[p] = h
            end
        end
    end
    for p, obj in pairs(highlights) do
        if not p.Parent then
            obj:Destroy()
            highlights[p] = nil
        end
    end
end

local function chooseTarget(cam)
    local viewport = cam.ViewportSize
    local centre = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local bestPart = nil
    -- Long range removes the screen-space FOV limit, not engine streaming/visibility limits.
    local bestDist = cfg.longRange and math.huge or cfg.fov
    local bestScreen = nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local ch = p.Character
            local hum = ch and ch:FindFirstChildOfClass('Humanoid')
            local part = ch and (ch:FindFirstChild(cfg.aimPart) or ch:FindFirstChild('HumanoidRootPart'))
            local sameTeam = cfg.team and LP.Team ~= nil and p.Team ~= nil and LP.Team == p.Team
            if ch and hum and hum.Health > 0 and part and not sameTeam then
                local screen, visible = cam:WorldToViewportPoint(part.Position)
                if visible and screen.Z > 0 then
                    local screenPoint = Vector2.new(screen.X, screen.Y)
                    local distance = (screenPoint - centre).Magnitude
                    if distance < bestDist then
                        local clear = true
                        if cfg.wall then
                            local params = RaycastParams.new()
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            params.FilterDescendantsInstances = {LP.Character or cam}
                            local hit = workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, params)
                            clear = (hit == nil) or hit.Instance:IsDescendantOf(ch)
                        end
                        if clear then
                            bestPart = part
                            bestDist = distance
                            bestScreen = screenPoint
                        end
                    end
                end
            end
        end
    end
    return bestPart, bestDist, bestScreen, centre
end

local renderKey = 'SatisHubMeliodasRender'
local okBind, errBind = pcall(function()
    RunService:BindToRenderStep(renderKey, Enum.RenderPriority.Camera.Value + 5, function()
        if not alive then return end
        local cam = workspace.CurrentCamera
        if not cam then return end

        local vs = cam.ViewportSize
        local centre = Vector2.new(vs.X / 2, vs.Y / 2)
        fov.Size = UDim2.fromOffset(cfg.fov * 2, cfg.fov * 2)
        fov.Position = UDim2.fromOffset(centre.X, centre.Y)
        fov.Visible = cfg.aim and cfg.circle

        if not cfg.aim then
            if lastTarget ~= nil then
                lastTarget = nil
                targetText.Text = 'TARGET: none'
            end
            return
        end

        local part, distance, screenPosition = chooseTarget(cam)
        if part then
            local model = part:FindFirstAncestorOfClass('Model')
            local name = model and model.Name or 'unknown'
            targetText.Text = 'TARGET: ' .. name
            lastTarget = part
            lastDistance = distance

            if cfg.aimMethod == 'Mouse' and type(mousemoverel) == 'function' and screenPosition then
                local offset = screenPosition - centre
                pcall(mousemoverel, offset.X * cfg.smooth, offset.Y * cfg.smooth)
            else
                local desired = CFrame.lookAt(cam.CFrame.Position, part.Position)
                cam.CFrame = cam.CFrame:Lerp(desired, cfg.smooth)
            end
        else
            lastTarget = nil
            lastDistance = nil
            targetText.Text = 'TARGET: none in FOV'
        end
    end)
end)
if not okBind then
    warn('[SatisHub] Aim render error:', errBind)
end

bind(RunService.Stepped, function()
    if not cfg.noclip then return end
    local ch = LP.Character
    if not ch then return end
    for _, part in ipairs(ch:GetDescendants()) do
        if part:IsA('BasePart') then
            if original[part] == nil then original[part] = part.CanCollide end
            part.CanCollide = false
        end
    end
end)
bind(LP.CharacterRemoving, restoreCollision)

local espTime = 0
bind(RunService.Heartbeat, function(dt)
    espTime = espTime + dt
    if espTime > 0.35 then
        espTime = 0
        refreshESP()
    end
end)

local function scheduleAfterTeleport()
    cfg.autoTeleport = true
    saveSettings()
    local q = getQueue()
    if type(q) ~= 'function' then
        warn('[SatisHub] No queue_on_teleport API; manual re-execution required.')
        return
    end
    local serialized = HttpService:JSONEncode(cfg)
    local bootstrap = string.format([[
local env = (type(getgenv) == 'function' and getgenv()) or _G
env.SatisHubMeliodasSeed = game:GetService('HttpService'):JSONDecode(%q)
local ok, body = pcall(function() return game:HttpGet(%q) end)
if not ok then warn('[SatisHub] Teleport download failed:', body) return end
local fn, errorText = loadstring(body)
if not fn then warn('[SatisHub] Teleport syntax:', errorText) return end
fn()
]], serialized, RAW_URL)
    local ok, errorText = pcall(q, bootstrap)
    if ok then
        teleportQueued = true
        warn('[SatisHub] Teleport queue registered with current settings.')
    else
        warn('[SatisHub] Teleport queue failed:', errorText)
    end
end

-- Queue right away so the code is prepared before the teleport begins.
-- Refresh at the start of a real place teleport to capture the latest toggles.
scheduleAfterTeleport()
bind(LP.OnTeleport, function(state)
    if state == Enum.TeleportState.Started then
        print('[SatisHub] OnTeleport Started; refreshing saved settings.')
        scheduleAfterTeleport()
    elseif state == Enum.TeleportState.Failed then
        warn('[SatisHub] Roblox reported that the teleport failed.')
    end
end)

local dragStart, startPosition
bind(main.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        and input.Position.Y <= main.AbsolutePosition.Y + 92
        and input.Position.X <= main.AbsolutePosition.X + 820 then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)

bind(UIS.InputChanged, function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
    end
end)

bind(UIS.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

bind(UIS.InputBegan, function(input, processed)
    if processed or UIS:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        if miniBar.Visible then
            miniBar.Visible = false
            main.Visible = true
        else
            main.Visible = not main.Visible
        end
    end
end)


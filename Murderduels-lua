    b.Position = UDim2.fromOffset(x, y)
    b.Size = UDim2.fromOffset(w, h)
    b.Text = value
    b.TextSize = 12
    b.Font = Enum.Font.GothamBold
    b.TextColor3 = WHITE
    b.AutoButtonColor = false
    b.ZIndex = 9
    b.Parent = parent
    rounded(b, 9)
    outline(b, Color3.fromRGB(95, 73, 32), 1, 0.25)
    bind(b.MouseEnter, function()
        TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(57, 41, 15)}):Play()

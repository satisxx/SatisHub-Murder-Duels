local function validEnemy(p)
    if p == LP or not p.Parent then return false end
    if cfg.team and LP.Team and p.Team and LP.Team == p.Team then return false end
    local char = p.Character
    local hum = char and char:FindFirstChildOfClass('Humanoid')
    local root = char and char:FindFirstChild('HumanoidRootPart')
    return root ~= nil and hum ~= nil and hum.Health > 0
end

local function refreshESP()
    if not cfg.esp then clearESP(); return end
    for _, p in ipairs(Players:GetPlayers()) do
        local ch = p.Character
        local enemy = validEnemy(p)
        if not enemy then
            if highlights[p] then highlights[p]:Destroy(); highlights[p] = nil end
            if tpTags[p] then tpTags[p]:Destroy(); tpTags[p] = nil end
        else
            if highlights[p] and highlights[p].Adornee ~= ch then
                highlights[p]:Destroy(); highlights[p] = nil
            end
            if not highlights[p] then
                local h = Instance.new('Highlight')
                h.Name = 'SatisHub_Anime_ESP'
                h.Adornee = ch
                h.FillColor = GOLD
                h.FillTransparency = 0.74
                h.OutlineColor = WHITE
                h.OutlineTransparency = 0
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = gui
                highlights[p] = h
            end
            local head = ch:FindFirstChild('Head') or ch:FindFirstChild('HumanoidRootPart')
            local tag = tpTags[p]
            if (not cfg.tpEnemy) or (not head) then
                if tag then tag:Destroy(); tpTags[p] = nil end
            elseif tag and tag.Adornee ~= head then
                tag:Destroy(); tpTags[p] = nil
            end
            if cfg.tpEnemy and head and not tpTags[p] then

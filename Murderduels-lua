-- Local persistence when readfile/writefile are available. The same path is kept
-- as V4.4, so an existing configuration is not lost when updating.
local savedToFile = false
local function saveSettings()
    cfg.autoTeleport = true
    cfg.aimMethod = 'Mouse'
    env.SatisHubAnimeCurrent = cfg
    if type(writefile) == 'function' then
        local ok, err = pcall(function()
            writefile(SETTINGS_FILE, HttpService:JSONEncode(cfg))
        end)
        savedToFile = ok
        if not ok then
            warn('[SatisHub] Could not save options:', tostring(err))
        end
    end
    return savedToFile
end


env.SatisHub1v1Cleanup=function()
    active=false;cfg.noclip=false;clearESP()
    for p,old in pairs(collisions) do if p.Parent then p.CanCollide=old end end
    table.clear(collisions)
    for _,c in ipairs(connections) do c:Disconnect() end
    gui:Destroy()
end

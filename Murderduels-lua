    local centre=aimPoint(cam)
    circle.Size=UDim2.fromOffset(cfg.fov*2,cfg.fov*2)
    circle.Position=UDim2.fromOffset(centre.X,centre.Y)
    circle.Visible=cfg.aim and cfg.showfov

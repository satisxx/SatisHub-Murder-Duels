local function rounded(obj, radius)
    local c = Instance.new('UICorner')
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
    return c
end

local function stroke(obj, color, thickness, transparency)
    local s = Instance.new('UIStroke')
    s.Color = color or GOLD
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.Parent = obj
    return s
end

local function frame(parent, x, y, w, h, color, z, transparency)
    local f = Instance.new('Frame')
    f.BorderSizePixel = 0
    f.Position = UDim2.fromOffset(x, y)
    f.Size = UDim2.fromOffset(w, h)
    f.BackgroundColor3 = color or PANEL
    f.BackgroundTransparency = transparency or 0
    f.ZIndex = z or 5
    f.Parent = parent
    return f
end

local function label(parent, value, x, y, w, h, size, color, font, z)
    local t = Instance.new('TextLabel')
    t.BackgroundTransparency = 1
    t.BorderSizePixel = 0
    t.Position = UDim2.fromOffset(x, y)
    t.Size = UDim2.fromOffset(w, h)
    t.Font = font or Enum.Font.Gotham
    t.Text = value
    t.TextColor3 = color or WHITE
    t.TextSize = size or 13
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextYAlignment = Enum.TextYAlignment.Center
    t.ZIndex = z or 8
    t.Parent = parent
    return t
end

local function glow(parent, x, y, w, h, color, alpha, z)
    local g = frame(parent, x, y, w, h, color or GOLD, z or 3, alpha or 0.75)
    rounded(g, 18)
    return g
end

local function tween(obj, info, props)
    local tw = TweenService:Create(obj, info, props)
    tw:Play()
    return tw
end

local function pulse(obj)
    if not obj then return end
    local original = obj.TextColor3
    tween(obj, TweenInfo.new(0.18), {TextColor3 = PALE})
    task.delay(0.18, function()
        if obj then tween(obj, TweenInfo.new(0.18), {TextColor3 = original}) end
    end)
end

local function makeButton(parent, value, x, y, w, h, fn)
    local backGlow = glow(parent, x - 2, y - 2, w + 4, h + 4, GOLD, 0.88, 7)
    backGlow.Visible = false
    local b = Instance.new('TextButton')
    b.BorderSizePixel = 0
    b.BackgroundColor3 = PANEL2
    b.BackgroundTransparency = 0.16
    b.Position = UDim2.fromOffset(x, y)
    b.Size = UDim2.fromOffset(w, h)
    b.Text = value
    b.TextSize = 12
    b.Font = Enum.Font.GothamBold
    b.TextColor3 = WHITE
    b.AutoButtonColor = false
    b.ZIndex = 9
    b.Parent = parent
    rounded(b, 10)
    stroke(b, Color3.fromRGB(115, 84, 26), 1, 0.18)
    b:SetAttribute('RestColor', b.BackgroundColor3)

    bind(b.MouseEnter, function()
        backGlow.Visible = true
        tween(backGlow, TweenInfo.new(0.12), {BackgroundTransparency = 0.82})
        tween(b, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(55, 40, 17)})
    end)
    bind(b.MouseLeave, function()
        tween(backGlow, TweenInfo.new(0.10), {BackgroundTransparency = 1})
        task.delay(0.11, function() if backGlow then backGlow.Visible = false end end)
        tween(b, TweenInfo.new(0.12), {BackgroundColor3 = b:GetAttribute('RestColor') or PANEL2})
    end)
    bind(b.MouseButton1Click, function()
        if fn then fn(b) end
    end)
    return b, backGlow
end


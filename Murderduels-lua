local animationId = 0
showPage = function(name, instant)
    if not pages[name] then return end
    if currentPage == name and not instant then return end
    animationId = animationId + 1
    local ownAnimation = animationId
    local old = currentPage and pages[currentPage] or nil
    local new = pages[name]
    currentPage = name
    pageTitle.Text = string.upper(name)
    pageSubtitle.Text = headerLabels[name]
    for key, b in pairs(navButtons) do
        local active = (key == name)
        local rest = active and Color3.fromRGB(95, 62, 13) or PANEL2
        b:SetAttribute('RestColor', rest)
        tween(b, TweenInfo.new(0.18, Enum.EasingStyle.Quart), {BackgroundColor3 = rest})
    end
    if instant or old == nil then
        for key, page in pairs(pages) do
            page.Visible = (key == name)
            page.GroupTransparency = (key == name) and 0 or 1
            page.Position = UDim2.fromOffset(238, 128)
        end
        return
    end
    if old and old ~= new then
        tween(old, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            GroupTransparency = 1,
            Position = UDim2.fromOffset(212, 128),
        })
    end
    new.Visible = true
    new.GroupTransparency = 1
    new.Position = UDim2.fromOffset(284, 128)
    tween(new, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        GroupTransparency = 0,
        Position = UDim2.fromOffset(238, 128),
    })
    tween(pageTitle, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {TextColor3 = GOLD})
    task.delay(0.24, function()
        if not alive or animationId ~= ownAnimation then return end
        for key, page in pairs(pages) do
            if key ~= name then
                page.Visible = false
                page.GroupTransparency = 1
                page.Position = UDim2.fromOffset(238, 128)
            end
        end
    end)
    task.delay(0.25, function()
        if alive then tween(pageTitle, TweenInfo.new(0.2), {TextColor3 = WHITE}) end
    end)
end


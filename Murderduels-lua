local function sliderRow(parent, caption, key, x, y, w, mn, mx, decimal)
    local c = frame(parent, x, y, w, 105, PANEL, 8, 0.04)
    rounded(c, 11)
    stroke(c, Color3.fromRGB(82, 66, 39), 1, 0.3)
    label(c, caption, 15, 10, w - 115, 34, 14, WHITE, Enum.Font.GothamBold, 10)
    local value = label(c, '', w - 108, 10, 92, 34, 14, GOLD, Enum.Font.GothamBold, 10)
    value.TextXAlignment = Enum.TextXAlignment.Right
    local track = frame(c, 18, 72, w - 36, 7, Color3.fromRGB(75, 73, 71), 10)
    rounded(track, 5)
    local filled = frame(track, 0, 0, 0, 7, GOLD, 11)
    rounded(filled, 5)
    local handle = frame(track, 0, -6, 19, 19, WHITE, 12)
    rounded(handle, 10)
    stroke(handle, GOLD, 2, 0.1)
    local active = false
    local function refresh()
        local alpha = math.clamp((cfg[key] - mn) / (mx - mn), 0, 1)
        filled.Size = UDim2.new(alpha, 0, 1, 0)
        handle.Position = UDim2.new(alpha, -10, 0, -6)
        value.Text = decimal == 0 and string.format('%d', cfg[key]) or string.format('%.2f', cfg[key])
    end
    local function setPos(mouseX)
        local alpha = math.clamp((mouseX - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
        local amount = mn + alpha * (mx - mn)
        cfg[key] = decimal == 0 and math.floor(amount + 0.5) or math.floor(amount * 100 + 0.5) / 100
        refresh()
        saveSettings()
    end
    bind(c.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            active = true
            setPos(input.Position.X)
        end
    end)
    bind(UIS.InputChanged, function(input)
        if active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setPos(input.Position.X)
        end
    end)
    bind(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then active = false end
    end)
    refresh()
    return c
end


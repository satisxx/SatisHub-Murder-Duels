local function slider(parent, caption, key, x, y, width, minimum, maximum, decimals)
    local holder = box(parent, x, y, width, 77, PANEL, 7, 0.04)
    rounded(holder, 9)
    local name = text(holder, caption, 12, 8, width - 102, 23, 12, WHITE, Enum.Font.GothamBold, 9)
    local value = text(holder, '', width - 110, 8, 99, 23, 13, GOLD, Enum.Font.GothamBold, 9)
    value.TextXAlignment = Enum.TextXAlignment.Right
    local track = box(holder, 14, 46, width - 28, 6, Color3.fromRGB(63, 63, 66), 9)
    rounded(track, 3)
    local fill = box(track, 0, 0, 0, 6, GOLD, 10)
    rounded(fill, 3)
    local knob = box(track, 0, -5, 16, 16, WHITE, 11)
    rounded(knob, 9)
    local sliding = false
    local function refresh()
        local alpha = math.clamp((cfg[key] - minimum) / (maximum - minimum), 0, 1)
        fill.Size = UDim2.new(alpha, 0, 0, 6)
        knob.Position = UDim2.new(alpha, -8, 0, -5)
        value.Text = decimals == 0 and string.format('%d', math.floor(cfg[key] + 0.5))
            or string.format('%.2f', cfg[key])
    end
    local function setAt(mouseX)
        local alpha = math.clamp((mouseX - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
        local amount = minimum + (maximum - minimum) * alpha
        cfg[key] = (decimals == 0) and math.floor(amount + 0.5) or math.floor(amount * 100 + 0.5) / 100
        refresh()
        saveSettings()
    end
    bind(holder.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            setAt(input.Position.X)
        end
    end)
    bind(UIS.InputChanged, function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setAt(input.Position.X)
        end
    end)
    bind(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
    refresh()
    return holder
end


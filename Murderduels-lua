        local part, distance, screenPosition = chooseTarget(cam)
        if part then
            local model = part:FindFirstAncestorOfClass('Model')
            local name = model and model.Name or 'unknown'
            if lastTarget ~= part then targetText.Text = 'TARGET: ' .. name end
            lastTarget, lastDistance = part, distance
            if cfg.aimMethod == 'Mouse' and type(mousemoverel) == 'function' then
                local offset = screenPosition - centre
                pcall(mousemoverel, offset.X * cfg.smooth, offset.Y * cfg.smooth)
            else
                local desired = CFrame.lookAt(cam.CFrame.Position, part.Position)
                cam.CFrame = cam.CFrame:Lerp(desired, cfg.smooth)
            end
        else
            if lastTarget ~= nil then targetText.Text = 'TARGET: none in FOV' end
            lastTarget, lastDistance = nil, nil
        end
    end)
end)

local pictureStatus = 'Imagem nao configurada'
local function applyImage()
    local assetId = tostring(cfg.backgroundAssetId or '0')
    assetId = assetId:match('^%s*(%d+)%s*$') or '0'
    if assetId ~= '0' then
        animePhoto.Image = 'rbxassetid://' .. assetId
        photoWarning.Visible = false
        pictureStatus = 'Asset ID selecionado: ' .. assetId
        return true
    end
    local custom = (type(getcustomasset) == 'function' and getcustomasset)
        or (type(getsynasset) == 'function' and getsynasset)
    if custom then
        local paths = {BACKGROUND_FILE, 'workspace/' .. BACKGROUND_FILE}
        for _, path in ipairs(paths) do
            local ok, asset = pcall(custom, path)
            if ok and type(asset) == 'string' and #asset > 0 then
                animePhoto.Image = asset
                pictureStatus = 'Imagem local: ' .. path
                photoWarning.Visible = false
                return true
            end
        end
    end
    animePhoto.Image = ''
    photoWarning.Visible = true
    pictureStatus = 'Imagem por configurar: usa o ID nas Settings'
    return false
end

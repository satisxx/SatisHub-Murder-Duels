-- Auto-execution is internal and has no menu entry.
-- If file I/O works, register one bootstrap immediately: it reads the LATEST
-- config on arrival. Without file I/O, queue only when teleport starts, taking
-- a fresh snapshot then. Both paths avoid registering duplicate bootstraps.
local function getQueue()
    if type(queue_on_teleport) == 'function' then return queue_on_teleport end
    if type(syn) == 'table' and type(syn.queue_on_teleport) == 'function' then
        return syn.queue_on_teleport
    end
    return nil
end
local teleportQueued = false
local function scheduleAfterTeleport()
    if teleportQueued then return true end
    cfg.autoTeleport = true
    cfg.aimMethod = 'Mouse'
    saveSettings()
    local q = getQueue()
    if type(q) ~= 'function' then
        warn('[SatisHub] Auto execute unsupported: queue_on_teleport is unavailable.')
        return false
    end
    local snapshot = HttpService:JSONEncode(cfg)
    local bootstrap = string.format([[
local ok, err = pcall(function()
    if not game:IsLoaded() then game.Loaded:Wait() end
    local env = (type(getgenv) == 'function' and getgenv()) or _G
    local service = game:GetService('HttpService')
    local options = service:JSONDecode(%q)
    if type(readfile) == 'function' then
        pcall(function()
            local saved = service:JSONDecode(readfile(%q))
            if type(saved) == 'table' then
                for key, expected in pairs(options) do
                    if type(saved[key]) == type(expected) then
                        options[key] = saved[key]
                    end
                end
            end
        end)
    end
    options.autoTeleport = true
    options.aimMethod = 'Mouse'
    env.SatisHubAnimeSeed = options
    local source = game:HttpGet(%q)
    local func, compileError = loadstring(source)
    assert(type(func) == 'function', tostring(compileError or 'compile error'))
    func()
end)
if not ok then warn('[SatisHub] Failed to load after server change:', tostring(err)) end
]], snapshot, SETTINGS_FILE, RAW_URL)
    local ok, err = pcall(q, bootstrap)
    if not ok then
        warn('[SatisHub] Could not queue execution:', tostring(err))
        return false
    end
    teleportQueued = true
    print('[SatisHub] Re-execution queued with saved options.')
    return true
end

local filePersistence = saveSettings()
if filePersistence and type(readfile) == 'function' then
    scheduleAfterTeleport()
else
    print('[SatisHub] File settings unavailable; capturing options at teleport start if supported.')
end
bind(LP.OnTeleport, function(state)
    if state == Enum.TeleportState.Started then
        saveSettings()
        if not teleportQueued then scheduleAfterTeleport() end
    end
end)

local dragStart, startPosition
bind(main.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 and input.Position.Y <= main.AbsolutePosition.Y + 92 and input.Position.X <= main.AbsolutePosition.X + 835 then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)
bind(UIS.InputChanged, function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
    end
end)
bind(UIS.InputEnded, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)

bind(UIS.InputBegan, function(input, processed)
    if processed or UIS:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.U then
        tpToEnemy()
        return
    end
    if input.KeyCode == Enum.KeyCode.RightShift then
        if miniBar.Visible then
            restoreWindow()
        else
            if main.Visible then
                tween(main, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.fromScale(0.5, 0.54)})
                task.delay(0.16, function() main.Visible = false end)
            else
                main.Visible = true
                main.Position = UDim2.fromScale(0.5, 0.52)
                tween(main, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.fromScale(0.5, 0.5)})
            end
        end
    end
end)



local function restoreCollision()
    for part, previous in pairs(original) do
        if part and part.Parent then part.CanCollide = previous end
    end
    table.clear(original)
end

local function makeToggle(parent, caption, key, x, y, width)
    width = width or 278
    local row = frame(parent, x, y, width, 44, PANEL, 7, 0.27)
    rounded(row, 10)
    stroke(row, Color3.fromRGB(92, 72, 44), 1, 0.45)

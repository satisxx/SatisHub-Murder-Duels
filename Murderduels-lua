local fov=Instance.new('Frame');fov.AnchorPoint=Vector2.new(.5,.5);fov.BackgroundTransparency=1;fov.Parent=gui;addCorner(fov,999);addStroke(fov,gold,1.5)
local function clearESP()
    for p,h in pairs(highlights) do if h then h:Destroy() end;highlights[p]=nil end
end
local function refreshESP()
    if not cfg.esp then clearESP();return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local char=p.Character
            if highlights[p] and (not char or highlights[p].Adornee ~= char) then highlights[p]:Destroy();highlights[p]=nil end
            if char and not highlights[p] then
                local h=Instance.new('Highlight');h.Name='SH_DuelHighlight';h.Adornee=char;h.FillColor=gold;h.OutlineColor=white;h.FillTransparency=.7;h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop;h.Parent=gui;highlights[p]=h
            end
        end
    end
    for p,h in pairs(highlights) do if not p.Parent then h:Destroy();highlights[p]=nil end end
end
local function findTarget()
    local cam=workspace.CurrentCamera
    if not cam then return nil end
    local mouse=UIS:GetMouseLocation()
    local best,dist=nil,cfg.fov
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local char=p.Character
            local hum=char:FindFirstChildOfClass('Humanoid')
            local part=char:FindFirstChild(cfg.target)
            if hum and hum.Health > 0 and part then
                local pos,visible=cam:WorldToViewportPoint(part.Position)
                local d=(Vector2.new(pos.X,pos.Y)-mouse).Magnitude
                if visible and pos.Z>0 and d<dist then
                    local allowed=true
                    if cfg.walls then
                        local param=RaycastParams.new();param.FilterType=Enum.RaycastFilterType.Exclude;param.FilterDescendantsInstances={LP.Character or cam}
                        local hit=workspace:Raycast(cam.CFrame.Position,part.Position-cam.CFrame.Position,param)
                        allowed=(hit==nil or hit.Instance:IsDescendantOf(char))
                    end
                    if allowed then best=part;dist=d end
                end
            end
        end
    end
    return best
end
connect(UIS.InputBegan,function(input,processed)
    if input.UserInputType==Enum.UserInputType.MouseButton2 then held=true end
    if not processed and input.KeyCode==Enum.KeyCode.RightShift then main.Visible=not main.Visible end
end)
connect(UIS.InputEnded,function(input)if input.UserInputType==Enum.UserInputType.MouseButton2 then held=false end end)
connect(close.MouseButton1Click,function()main.Visible=false end)
connect(RunService.Stepped,function()
    if not cfg.noclip then return end
    local char=LP.Character;if not char then return end
    for _,v in ipairs(char:GetDescendants()) do
        if v:IsA('BasePart') then
            if collisions[v]==nil then collisions[v]=v.CanCollide end
            v.CanCollide=false
        end
    end
end)
connect(LP.CharacterRemoving,function() table.clear(collisions) end)
connect(RunService.RenderStepped,function()
    if not active then return end
    local mouse=UIS:GetMouseLocation();fov.Position=UDim2.fromOffset(mouse.X,mouse.Y);fov.Size=UDim2.fromOffset(cfg.fov*2,cfg.fov*2);fov.Visible=cfg.aim and cfg.circle
    if cfg.aim and held then
        local cam=workspace.CurrentCamera;local target=findTarget()
        if cam and target then cam.CFrame=cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position,target.Position),cfg.smooth) end
    end
end)

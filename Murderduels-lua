bind(main.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 and input.Position.Y <= main.AbsolutePosition.Y + 92 and input.Position.X <= main.AbsolutePosition.X + 835 then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)

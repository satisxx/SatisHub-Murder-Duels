-- Press U to teleport behind the enemy nearest to the center of the screen.
-- This is a local movement request; server validation can undo the move.
local lastTp = 0
local function tpToEnemy()
    if not cfg.tpEnemy or not cfg.esp then return end
    if os.clock() - lastTp < 1 then return end
    local character = LP.Character
    local localRoot = character and character:FindFirstChild('HumanoidRootPart')
    local cam = workspace.CurrentCamera
    if not localRoot or not cam then return end
    local center = cam.ViewportSize / 2
    local bestPlayer = nil
    local bestScore = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if validEnemy(p) then
            local theirRoot = p.Character:FindFirstChild('HumanoidRootPart')
            local projected, visible = cam:WorldToViewportPoint(theirRoot.Position)
            if visible and projected.Z > 0 then
                local delta = Vector2.new(projected.X, projected.Y) - center
                local score = delta.Magnitude
                if score < bestScore then
                    bestPlayer = p
                    bestScore = score
                end
            end
        end
    end
    if not bestPlayer then
        if statusText then statusText.Text = '●  TP: no visible enemy' end
        return
    end
    local enemyRoot = bestPlayer.Character and bestPlayer.Character:FindFirstChild('HumanoidRootPart')
    if not enemyRoot then return end
    lastTp = os.clock()
    local behind = enemyRoot.CFrame * CFrame.new(0, 0, 4)
    local destination = CFrame.lookAt(behind.Position, enemyRoot.Position)
    character:PivotTo(destination)
    if statusText then statusText.Text = '●  TP behind ' .. bestPlayer.Name end
end

local function chooseTarget(cam)
    local viewport = cam.ViewportSize
    local centre = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local bestPart, bestScreen = nil, nil
    local bestDist = cfg.longRange and math.huge or cfg.fov
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local ch = p.Character
            local hum = ch and ch:FindFirstChildOfClass('Humanoid')
            local part = ch and (ch:FindFirstChild(cfg.aimPart) or ch:FindFirstChild('HumanoidRootPart'))
            local sameTeam = cfg.team and LP.Team ~= nil and p.Team ~= nil and LP.Team == p.Team
            if ch and hum and hum.Health > 0 and part and not sameTeam then
                local screen, visible = cam:WorldToViewportPoint(part.Position)
                if visible and screen.Z > 0 then
                    local point = Vector2.new(screen.X, screen.Y)
                    local distance = (point - centre).Magnitude
                    if distance < bestDist then
                        local clear = true
                        if cfg.wall then
                            local params = RaycastParams.new()
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            params.FilterDescendantsInstances = {LP.Character or cam}
                            local hit = workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, params)
                            clear = (hit == nil) or hit.Instance:IsDescendantOf(ch)
                        end
                        if clear then
                            bestPart = part
                            bestDist = distance
                            bestScreen = point
                        end
                    end
                end
            end
        end
    end
    return bestPart, bestDist, bestScreen, centre
end


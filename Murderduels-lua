-- Queue once, at startup, to avoid duplicate bootstrap executions.
-- The queued code first reads the latest saved settings, so changes after
 -- queue registration persist without queuing the same script repeatedly.
local teleportQueued = false
local function scheduleAfterTeleport()
    if teleportQueued then return true end
    cfg.autoTeleport = true
    saveSettings()
    local q = getQueue()
    if type(q) ~= 'function' then
        warn('[SatisHub] Auto teleport unavailable: queue_on_teleport not supported.')
        return false
    end
    local snapshot = HttpService:JSONEncode(cfg)
    local bootstrap = string.format([[
local ok, err = pcall(function()
    if not game:IsLoaded() then game.Loaded:Wait() end
    local env = (type(getgenv) == 'function' and getgenv()) or _G
    local settings = game:GetService('HttpService'):JSONDecode(%q)
    if type(readfile) == 'function' then
        pcall(function()
            local saved = game:GetService('HttpService'):JSONDecode(readfile(%q))
            if type(saved) == 'table' then
                for k, v in pairs(settings) do
                    if type(saved[k]) == type(v) then settings[k] = saved[k] end
                end
            end
        end)
    end
    settings.autoTeleport = true
    env.SatisHubAnimeSeed = settings
    local source = game:HttpGet(%q)
    local fn, compileError = loadstring(source)
    assert(type(fn) == 'function', tostring(compileError or 'unknown compile error'))
    fn()
end)
if not ok then warn('[SatisHub] Error loading after teleport:', err) end
]], snapshot, SETTINGS_FILE, RAW_URL)
    local ok, err = pcall(q, bootstrap)
    if ok then
        teleportQueued = true
        print('[SatisHub] Auto Execute queued. Saved settings will reload when available.')
        return true
    end
    warn('[SatisHub] Could not queue autoexecute:', err)
    return false
end
scheduleAfterTeleport()
-- Save the latest state when teleport begins; do not register a second copy.
bind(LP.OnTeleport, function(state)
    if state == Enum.TeleportState.Started then
        saveSettings()
        if not teleportQueued then scheduleAfterTeleport() end
    end
end)


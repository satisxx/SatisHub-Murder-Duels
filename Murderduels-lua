        local amount = mn + alpha * (mx - mn)
        cfg[key] = decimal == 0 and math.floor(amount + 0.5) or math.floor(amount * 100 + 0.5) / 100
        refresh()
        saveSettings()
    end
    bind(c.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            active = true
            setPos(input.Position.X)

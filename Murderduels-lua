local function refreshESP()
    if not cfg.esp then clearESP(); return end
    local playersNow = Players:GetPlayers()
    for _, p in ipairs(playersNow) do
        if p ~= LP then
            local ch = p.Character
            if highlights[p] and (not ch or highlights[p].Adornee ~= ch) then
                highlights[p]:Destroy()
                highlights[p] = nil
            end
            if ch and not highlights[p] then
                local h = Instance.new('Highlight')
                h.Name = 'SatisHub_67_ESP'
                h.Adornee = ch
                h.FillColor = GOLD
                h.FillTransparency = 0.72
                h.OutlineColor = WHITE
                h.OutlineTransparency = 0
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = gui
                highlights[p] = h

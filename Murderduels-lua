-- Inputs / clean dragging (header only)
local dragStart, startPosition
bind(main.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        and input.Position.Y <= main.AbsolutePosition.Y + 92
        and input.Position.X <= main.AbsolutePosition.X + 830 then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)
bind(UIS.InputChanged, function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
    end
end)
bind(UIS.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
bind(UIS.InputBegan, function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.RightShift and not UIS:GetFocusedTextBox() then
        main.Visible = not main.Visible
    end
end)


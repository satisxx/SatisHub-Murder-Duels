local function decodeBase64(data)
    local alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    local map = {}
    for i = 1, #alphabet do map[alphabet:sub(i, i)] = i - 1 end
    local out = {}
    local acc, bits = 0, 0
    for i = 1, #data do
        local ch = data:sub(i, i)
        local n = map[ch]
        if n then
            acc = acc * 64 + n
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local byte = math.floor(acc / (2 ^ bits)) % 256
                out[#out + 1] = string.char(byte)
                acc = acc % (2 ^ bits)
            end
        end
    end
    return table.concat(out)
end

local function getLocalImage(originalPath, embeddedPath, b64)
    local getter = (type(getcustomasset) == 'function' and getcustomasset)
        or (type(getsynasset) == 'function' and getsynasset)
    if type(getter) ~= 'function' then return nil end

    -- Prefer the version embedded in this script so no extra files are needed.
    if type(writefile) == 'function' then
        local ok = pcall(function()
            writefile(embeddedPath, decodeBase64(b64))
        end)
        if ok then
            for _, p in ipairs({embeddedPath, 'workspace/' .. embeddedPath}) do
                local success, asset = pcall(getter, p)
                if success and type(asset) == 'string' and #asset > 0 then return asset end
            end
        end
    end

    -- Alternative: a separately copied asset in the executor's workspace.
    for _, p in ipairs({originalPath, 'workspace/' .. originalPath}) do
        local exists = true
        if type(isfile) == 'function' then
            local ok, value = pcall(isfile, p)
            exists = ok and value == true
        end
        if exists then
            local ok, result = pcall(getter, p)
            if ok and type(result) == 'string' and #result > 0 then return result end
        end
    end
    return nil
end






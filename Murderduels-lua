showPage = function(name, instant)
    local incoming = pages[name]
    if not incoming then return end
    if currentPage == name and not instant then return end

    pageTitle.Text = string.upper(name)
    pageSubtitle.Text = pageSubtitles[name] or 'SATISHUB'

    for tabName, btn in pairs(navButtons) do
        local activeButton = (tabName == name)
        btn.BackgroundColor3 = activeButton and Color3.fromRGB(111, 72, 15) or PANEL2
        btn.TextColor3 = activeButton and GOLD or WHITE
        btn:SetAttribute('RestColor', btn.BackgroundColor3)
    end

    if instant or currentPage == nil then
        for tabName, page in pairs(pages) do
            page.Visible = (tabName == name)
            page.Position = pagePositions.base
        end
        currentPage = name
        return
    end

    local outgoing = pages[currentPage]
    currentPage = name

    if outgoing and outgoing ~= incoming then
        outgoing.Visible = true
        local tweenOut = TweenService:Create(outgoing, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = pagePositions.exit
        })
        tweenOut:Play()
        task.delay(0.16, function()
            if outgoing and currentPage ~= nil and outgoing ~= pages[currentPage] then
                outgoing.Visible = false
                outgoing.Position = pagePositions.base
            end
        end)
    end

    incoming.Visible = true
    incoming.Position = pagePositions.enter
    TweenService:Create(incoming, TweenInfo.new(0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = pagePositions.base
    }):Play()

    for tabName, page in pairs(pages) do
        if tabName ~= name and page ~= outgoing then
            page.Visible = false
            page.Position = pagePositions.base
        end
    end
end


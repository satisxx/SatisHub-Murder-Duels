local function clearESP()
    for p, obj in pairs(highlights) do
        pcall(function() obj:Destroy() end)
        highlights[p] = nil
    end
end

local function refreshESP()
    if not cfg.esp then clearESP(); return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local ch = p.Character
            if highlights[p] and (not ch or highlights[p].Adornee ~= ch) then
                highlights[p]:Destroy()
                highlights[p] = nil
            end
            if ch and not highlights[p] then
                local h = Instance.new('Highlight')
                h.Name = 'SatisHub_Anime_ESP'
                h.Adornee = ch
                h.FillColor = GOLD
                h.FillTransparency = 0.74
                h.OutlineColor = WHITE
                h.OutlineTransparency = 0
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = gui
                highlights[p] = h
            end
        end
    end
    for p, obj in pairs(highlights) do
        if not p.Parent then obj:Destroy(); highlights[p] = nil end
    end
end

local function chooseTarget(cam)
    local viewport = cam.ViewportSize
    local centre = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local bestPart, bestScreen = nil, nil
    local bestDist = cfg.longRange and math.huge or cfg.fov
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local ch = p.Character
            local hum = ch and ch:FindFirstChildOfClass('Humanoid')
            local part = ch and (ch:FindFirstChild(cfg.aimPart) or ch:FindFirstChild('HumanoidRootPart'))
            local sameTeam = cfg.team and LP.Team ~= nil and p.Team ~= nil and LP.Team == p.Team
            if ch and hum and hum.Health > 0 and part and not sameTeam then
                local screen, visible = cam:WorldToViewportPoint(part.Position)
                if visible and screen.Z > 0 then
                    local point = Vector2.new(screen.X, screen.Y)
                    local distance = (point - centre).Magnitude
                    if distance < bestDist then
                        local clear = true
                        if cfg.wall then
                            local params = RaycastParams.new()
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            params.FilterDescendantsInstances = {LP.Character or cam}
                            local hit = workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, params)
                            clear = (hit == nil) or hit.Instance:IsDescendantOf(ch)
                        end
                        if clear then
                            bestPart = part
                            bestDist = distance
                            bestScreen = point
                        end
                    end
                end
            end
        end
    end
    return bestPart, bestDist, bestScreen, centre
end

local renderKey = 'SatisHubAnimeRender'
local okBind, errBind = pcall(function()
    RunService:BindToRenderStep(renderKey, Enum.RenderPriority.Camera.Value + 5, function()
        if not alive then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local vs = cam.ViewportSize
        local centre = Vector2.new(vs.X / 2, vs.Y / 2)
        fov.Size = UDim2.fromOffset(cfg.fov * 2, cfg.fov * 2)
        fov.Position = UDim2.fromOffset(centre.X, centre.Y)
        fov.Visible = cfg.aim and cfg.circle and not cfg.longRange and not main.Visible
        if not cfg.aim then
            targetText.Text = 'TARGET: none'
            return
        end
        local part, distance, screenPosition = chooseTarget(cam)
        if part then
            local model = part:FindFirstAncestorOfClass('Model')
            local name = model and model.Name or 'unknown'
            targetText.Text = 'TARGET: ' .. name
            -- Mouse is the only allowed aiming method in this version.
            if type(mousemoverel) == 'function' and screenPosition then
                local offset = screenPosition - centre
                pcall(mousemoverel, offset.X * cfg.smooth, offset.Y * cfg.smooth)
            end
        else
            targetText.Text = cfg.longRange and 'TARGET: none visible' or 'TARGET: none in FOV'
        end
    end)
end)
if not okBind then warn('[SatisHub] Aim render error:', errBind) end

